    "Right-click an app in the mixer and choose Ignore to leave its sound alone and keep it off the list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke im Mixer mit der rechten Maustaste auf eine App und wähle „Ignorieren“: Smorza lässt dann ihren Ton in Ruhe und zeigt sie nicht mehr an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur une app dans le mélangeur et choisissez Ignorer : Smorza ne touche plus à son son et ne l’affiche plus."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desnim klikom na aplikaciju u mikseru odaberite Ignoriraj: Smorza tada ne dira njezin zvuk i ne prikazuje je."
          }
        }
      }
    },
