    "Every app gets its own volume, mute and output.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede App bekommt eigene Lautstärke, Stummschaltung und Ausgabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque app a son propre volume, sa sourdine et sa sortie."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka aplikacija dobiva svoju glasnoću, utišavanje i izlaz."
