    "Ignored apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorierte Apps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps ignorées"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorirane aplikacije"
          }
        }
      }
    },
    "In System Settings, open Privacy & Security, then Screen & System Audio Recording, and turn on Smorza under System Audio Recording Only. Then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in den Systemeinstellungen „Datenschutz & Sicherheit“, dann „Bildschirm- & Systemaudioaufnahme“, und aktiviere Smorza unter „Nur Systemaudioaufnahme“. Versuche es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système, ouvrez Confidentialité et sécurité, puis Enregistrement de l’écran et de l’audio du système, et activez Smorza sous Enregistrement de l’audio du système uniquement. Puis réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U Postavkama sustava otvorite Privatnost i sigurnost, zatim Snimanje zaslona i zvuka sustava, i uključite Smorzu pod Samo snimanje zvuka sustava. Zatim pokušajte ponovno."
          }
        }
      }
    },
    "In the dialog macOS shows, click Allow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke im Dialog von macOS auf „Erlauben“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la fenêtre de macOS, cliquez sur Autoriser."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U dijalogu koji prikaže macOS kliknite Dozvoli."
          }
        }
      }
    },
