    "Mutes every app here": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet alle Apps hier stumm"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe le son de toutes les apps ici"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utišava sve aplikacije ovdje"
          }
        }
