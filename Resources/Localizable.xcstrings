    },
    "Mutes every app in Smorza. Unmute All Apps gives each its mute back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet alle Apps in Smorza stumm. „Stummschaltung aller Apps aufheben“ stellt den vorherigen Zustand wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe le son de toutes les apps dans Smorza. « Rétablir le son de toutes les apps » rend à chacune son état d’avant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utišava sve aplikacije u Smorzi. „Vrati zvuk svim aplikacijama” svakoj vraća prijašnje stanje."
          }
        }
      }
    },
    "Mutes or unmutes an app in Smorza, or toggles its mute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet eine App in Smorza stumm, wieder laut oder um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe ou rétablit le son d’une app dans Smorza, ou bascule son état."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utišava aplikaciju u Smorzi, vraća joj zvuk ili prebacuje utišavanje."
          }
        }
      }
    },
