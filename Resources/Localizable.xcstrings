    "Gives every app its mute from before": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede App bekommt ihre vorherige Stummschaltung zurück"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend à chaque app son état d’avant"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svakoj aplikaciji vraća prijašnje stanje"
          }
        }
      }
    },
    "Gives every app the mute it had before Mute All Apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt jeder App die Stummschaltung zurück, die sie vor „Alle Apps stummschalten“ hatte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend à chaque app l’état qu’elle avait avant « Couper le son de toutes les apps »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svakoj aplikaciji vraća stanje zvuka od prije radnje „Utišaj sve aplikacije”."
          }
        }
      }
    },
    "Hold Option to change the Mac's volume instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Wahltaste gedrückt, um stattdessen die Mac-Lautstärke zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez Option pour régler plutôt le volume du Mac."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite Option da biste umjesto toga mijenjali glasnoću Maca."
          }
        }
      }
    },
